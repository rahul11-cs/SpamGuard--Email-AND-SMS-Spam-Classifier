# PostgreSQL + pgvector connection configuration (supply your own credentials via secret manager)
PGHOST=""
PGPORT="5432"
PGDATABASE=""
PGUSER=""
PGPASSWORD=""
PGSSLMODE="require"

# Public deployment security controls
# Generate a strong random token (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
ADMIN_API_TOKEN=""
ENABLE_PUBLIC_HISTORY="false"
ALLOWED_ORIGINS="https://spam-classifierx.vercel.app"

# Optional Flask REST API endpoint used by Streamlit when REST mode is selected
FLASK_API_URL=""
